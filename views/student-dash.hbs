            {{!-- Homework Section --}}
            <section>
                   <div class="section__content section__content--p30">
                    <div class="container-fluid">
                        <div class="row">
                        <div class="col-lg-10">
                                <div class="au-card au-card--no-shadow au-card--no-pad m-b-40">
                                    <div class="au-card-title" style="background-image:url('/images/bg-title-01.jpg');">
                                        <div class="bg-overlay bg-overlay--blue"></div>
                                        <h3>
                                            <i class="fa fa-list"></i>Topshiriqlar</h3>
                                    </div>
                                    <div class="au-task js-list-load">
                                        {{#if studentGroup}}
                                         <div class="au-task__title">
                                            <p>Guruh: <b>{{group.groupName}}, </b> Daraja: <b>{{group.level}}</p>
                                            
                                        </div>    
                                        {{else}}
                                         <div class="au-task__title">
                                            <p>Guruh: <b>Afsuski, Siz hech qanday Guruh tarkibida emassiz!</b></p>
                                        </div>
                                        {{/if}}
                                        <div class="au-task-list js-scrollbar3">
                                            {{#if myTasks.length}}
                                            {{#each myTasks}}   
                                            {{#ifequal status "Pending"}}
                                            <div class="au-task__item au-task__item--primary">
                                                <div class="au-task__item-inner">
                                                    <h5 class="task">
                                                       <p><b>Topshiriq yuborildi.</b>  <b>Status: </b> Pending!</p>
                                                    </h5>
                                                    <span class="time">{{formatDate date}}</span>
                                                </div>
                                            </div> 
                                            {{/ifequal}}
                                            {{#ifequal status "Completed"}}
                                            <div class="au-task__item au-task__item--success">
                                                <div class="au-task__item-inner">
                                                    <h5 class="task">
                                                       <p><b>Topshiriq tekshirildi.</b>  <b>Status: </b> Completed!</p>
                                                    </h5>
                                                    <span class="time">{{formatDate date}}</span>
                                                </div>
                                            </div> 
                                            {{/ifequal}}
                                            {{#ifequal status "Not-Completed"}}
                                            <div class="au-task__item au-task__item--primary">
                                                <div class="au-task__item-inner">
                                                    <h5 class="task">
                                                       <p><b>Topshiriq tekshirildi.</b>  <b>Status: </b> Not-Completed!</p>
                                                    </h5>
                                                    <span class="time">{{formatDate date}}</span>
                                                </div>
                                            </div> 
                                            {{/ifequal}}
                                            {{#ifequal status "Cheated"}}
                                            <div class="au-task__item au-task__item--warning">
                                                <div class="au-task__item-inner">
                                                    <h5 class="task">
                                                       <p><b>Topshiriq tekshirildi.</b>  <b>Status: </b> Cheated!</p>
                                                    </h5>
                                                    <span class="time">{{formatDate date}}</span>
                                                </div>
                                            </div> 
                                            {{/ifequal}}
                                            {{#ifequal status "Failed"}}
                                            <div class="au-task__item au-task__item--danger">
                                                <div class="au-task__item-inner">
                                                    <h5 class="task">
                                                       <p><b>Topshiriq tekshirildi.</b>  <b>Status: </b> Failed!</p>
                                                    </h5>
                                                    <span class="time">{{formatDate date}}</span>
                                                </div>
                                            </div> 
                                            {{/ifequal}}
                                            {{/each}}
                                            {{else}}
                                            <div class="au-task__item-inner">
                                                    <h5 class="task">
                                                       <p>Siz hech qanday topshiriqlarni bajarmagansiz :(</p>
                                                    </h5>
                                            </div>
                                            {{/if}}

                                        </div>

                                    </div>
                                </div>
                            </div>    
                        </div>
            </section>
                
            <br>   
            {{!-- Upload File Section --}}
            <section>
                {{#ifequal existGroup null}}
                <div class="upload-file-container">
                        <form action="/send-task/{{id}}" method="post" class="form" enctype="multipart/form-data">
                        <span class="form-title">Topshiriqlarni yuklang</span>
                        <p class="form-paragraph">
                            Fayllar rasm ko'rinishida bo'lishi shart
                            </p>
                        <label for="file-input" class="drop-container" style="cursor: not-allowed;">
                        <span class="drop-title">Guruhga qo'shilganingizdan so'ng fayllarni shu yerga yuklaysiz va Yuborish tugmasini bosasiz!</span>
                        {{!-- <input name="taskFile" type="file" accept="image/*" id="disabled-file-input" multiple required style="cursor: not-allowed;" disabled> --}}
                        </label>
                        
                        <button class="upd-button" style="cursor: not-allowed;" disabled>  
                        <div class="upd-text">Yuborish</div>
                        </button>
                        </form>
                </div>
                {{else}} 
                <div class="upload-file-container">
                        <form action="/send-task/{{id}}" method="post" class="form" enctype="multipart/form-data">
                        <span class="form-title">Topshiriqlarni yuklang</span>
                        <p class="form-paragraph">
                            Fayllar rasm ko'rinishida bo'lishi shart
                            </p>
                        <label for="file-input" class="drop-container">
                        <span class="drop-title">Fayllarni shu yerga tashlang</span>
                        yoki
                        <input name="taskFile" type="file" accept="image/*" id="file-input" multiple required>
                        </label>
                        
                        <button class="upd-button">  
                        <div class="upd-text">Yuborish</div>
                        </button>
                        </form>
                </div>
                {{/ifequal}}
            </section>

            <br>
               
            <section>
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-12"  style="min-height: 100px;">
                            <div class="copyright">
                    <p><b>StephenSchool Learning Center.</b> 
                    <b style="text-decoration: underline;">v1.1.3</b></p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        

    </div>

