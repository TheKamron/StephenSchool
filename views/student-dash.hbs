                                <a href="/student-settings/{{id}}">
                                    <i class="fas fa-cog"></i>Sozlamalar</a>
                            </li>  
                        </ul>
                    </nav>
                </div>
            </aside>
            <!-- END HEADER DESKTOP-->

<div class="modal fade" id="smallmodal" tabindex="-1" role="dialog" aria-labelledby="smallmodalLabel" aria-hidden="true">
				<div class="modal-dialog modal-sm" role="document">
					<div class="modal-content">
						<div class="modal-header">
							<h5 class="modal-title" id="smallmodalLabel">Taklifnoma</h5>
							<button type="button" class="close" data-dismiss="modal" aria-label="Close">
								<span aria-hidden="true">&times;</span>
							</button>
						</div>
						<div class="modal-body">
							<div class="modal-body">
                                <ul>
                                <li style="list-style: none;">Guruh Nomi: <b>{{inviteInfo.groupName}}</b></li>
                                <li style="list-style: none;">Fan: <b>{{inviteInfo.subject}}</b> </li>
                                <li style="list-style: none;">Daraja: <b>{{inviteInfo.level}}</b></li>
                            </ul>
							 
                        <div class="modal-footer">
                            <form action="/join/{{inviteInfo.id}}" method="post">
                                <button type="submit" class="btn btn-success">Qo'shilish</button>
                            </form>
							<form action="/cancel/{{id}}" method="post">
                                <button type="submit" class="btn btn-danger">Bekor qilish</button>
                            </form>
						</div>
                            
						</div>
						</div>
						
					</div>
				</div>
</div>

    {{!-- Success Alert --}}
    {{#if loginSuccess}}
    <div class="success">
    <svg class="success__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
        <path d="M10 15.172l-3.95-3.95-1.414 1.414L10 18l9-9-1.414-1.414z"></path>
    </svg>
    <span class="success__title">{{loginSuccess}}</span>
    <svg class="success__close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
        <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"></path>
    </svg>
    </div>
    <script>
     const successElement = document.querySelector('.success');   
    document.querySelector('.success__close').addEventListener('click', function () {
    const successElement = document.querySelector('.success');
    successElement.style.display = 'none';});
    if (successElement) {
            // 5 soniyadan keyin elementni yashiramiz
            setTimeout(() => {
                successElement.style.display = 'none';
            }, 10000); // 5000ms = 5 sekund
        }
    </script>
    {{/if}}

            <!-- INVITATION-->
            {{#if invitation}}
            <section class="au-breadcrumb m-t-75">
                <div class="section__content section__content--p30">
                    <div class="container-fluid">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="au-breadcrumb-content">
                                    <div class="au-breadcrumb-left">
                                        <span class="au-breadcrumb-span"> <b>{{inviteInfo.groupName}}</b></span>
                                        <ul class="list-unstyled list-inline au-breadcrumb__list">
                                            <li class="list-inline-item active">
                                                <p>Guruhi sizni guruhga qo'shmoqchi...</p>
                                            </li>
                                <button class="au-btn2 au-btn-icon au-btn--green" data-toggle="modal" data-target="#smallmodal">Batafsil</button>

                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            {{else}}
            <section>
                <div class="section__content section__content--p30">
                    <div class="container-fluid">
                        <div class="row">
                            <div class="col-md-12">
                            
                            </div>
                        </div>
                    </div>
                </div>
            </section>
            {{/if}}
            <!-- END INVITATION-->
            
                                                                                                                                                                                                                            <br>
                                                                                                                                                                                                                            <br>
                                                                                                                                                                                                                            <br>
                                                                                                                                                                                                                            <br>
            

            {{!-- Homework Section --}}
            <section>
                   <div class="section__content section__content--p30">
                    <div class="container-fluid">
                        <div class="row">
                        <div class="col-lg-10">
                                <div class="au-card au-card--no-shadow au-card--no-pad m-b-40">
                                    <div class="au-card-title" style="background-image:url('images/bg-title-01.jpg');">
                                        <div class="bg-overlay bg-overlay--blue"></div>
                                        <h3>
                                            <i class="fa fa-list"></i>Uyga Vazifalar</h3>
                                    </div>
                                    <div class="au-task js-list-load">
                                        {{#if studentGroup}}
                                         <div class="au-task__title">
                                            <p>Guruh: <b>{{group.groupName}}, </b> Daraja: <b>{{group.level}}</p>
                                            
                                        </div>    
                                        {{else}}
                                         <div class="au-task__title">
                                            <p>Guruh: <b>Afsuski, Siz hech qanday Guruh tarkibida emassiz!</b></p>
                                        </div>
                                        {{/if}}
                                        <div class="au-task-list js-scrollbar3">
                                            {{#if homework.length}}
                                            {{#each homework}}
                                            <div class="au-task__item au-task__item--success">
                                                <div class="au-task__item-inner">
                                                    <h5 class="task">
                                                       <p><b>Mavzu:</b> {{homeworkLesson}}, <b>Vazifalar:</b> {{tasks}}</p>
                                                    </h5>
                                                    <span class="time">{{formatDate postedAt}}</span>
                                                </div>
                                            </div>
                                            {{/each}}
                                            {{else}}
                                            <div class="au-task__item-inner">
                                                    <h5 class="task">
                                                       <p>Hozircha hech qanday Uyga Vazifalar yo'q!</p>
                                                    </h5>
                                                </div>
                                            {{/if}}
                                            <div class="au-task__item au-task__item--danger js-load-item" style="display: none;">
                                                <div class="au-task__item-inner">
                                                    <h5 class="task">
                                                        <p href="#">Meeting about plan for Admin Template 2018</p>
                                                    </h5>
                                                    <span class="time">10:00 AM</span>
                                                </div>
                                            </div>

                                        </div>

                                    </div>
                                </div>
                            </div>    
                        </div>
            </section>
            {{!-- End Homework Section --}}
                

               
            <section>
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-12"  style="min-height: 100px;">
                            <div class="copyright">
                    <p><b>StephenSchool Learning Center.</b> 
                    Developed by: <a  href="https://t.me/offcodev"><b>offcodev</b></a></p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        

    </div>

