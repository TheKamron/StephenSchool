                                </div>
                                <div class="notifi__footer">
                                    <a href="#">All notifications</a>
                                </div>
                            </div> --}}
                        </div>
                    {{!-- Profile Settings --}}
                        <div class="account-wrap">
                            <div class="account-item account-item--style2 clearfix js-item-menu">
                                <div class="image">
                                    <img src="/images/{{avatar}}.jpg" alt="Avatar" />
                                </div>
                                <div class="content">
                                    <a class="js-acc-btn" href="#">{{firstName}} {{surName}}</a>
                                </div>
                                <div class="account-dropdown js-dropdown">
                                    <div class="info clearfix">
                                        <div class="image">
                                            <a href="#">
                                                <img src="/images/{{avatar}}.jpg" alt="Avatar" />
                                            </a>
                                        </div>
                                        <div class="content">
                                            <h5 class="name">
                                                <a href="#">{{firstName}} {{surName}}</a>
                                            </h5>
                                            <span class="email">{{phoneNumber}}</span>
                                        </div>
                                    </div>
                                    <div class="account-dropdown__body">
                                        <div class="account-dropdown__item">
                                            <a href="/teacher-dashboard/{{id}}">
                                                <i class="zmdi zmdi-home"></i>Bosh Sahifa</a>
                                        </div>
                                        <div class="account-dropdown__item">
                                            <a href="/teacher-profile/{{id}}">
                                                <i class="zmdi zmdi-account"></i>Profil</a>
                                        </div>
                                        <div class="account-dropdown__item">
                                            <a href="/teacher-settings/{{id}}">
                                                <i class="zmdi zmdi-settings"></i>Sozlamalar</a>
                                        </div>
                                    </div>
                                    <div class="account-dropdown__footer">
                                        <a href="/logout">
                                            <i class="zmdi zmdi-power"></i>Chiqish</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {{!-- Profile Settings --}}
                    </div>
                </div>
            </div>
        </header>
        <!-- END HEADER DESKTOP -->

        <!-- PAGE CONTENT-->
        <div class="page-container3">
            <section class="alert-wrap p-t-30 p-b-30">
                <div class="container">
                </div>
            </section>
            <section>
                <div class="container">
                    <div class="row">
                        <div class="col-xl-3">

                            <!-- MENU SIDEBAR-->
                            <aside class="menu-sidebar3 js-spe-sidebar">
                                <nav class="navbar-sidebar2 navbar-sidebar3">
                                    <ul class="list-unstyled navbar__list">
                                        <li class="has-sub">
                                <a href="/teacher-dashboard/{{id}}"><i class="fas fa-house"></i>Bosh Sahifa</a>                             
                                        </li>
                                        <li>
                                            <a href="/teacher-profile/{{id}}">
                                                <i class="fas fa-user"></i>Profil</a>
                                        </li>
                                        <li class="has-sub">
                                            <a href="/teacher-settings/{{id}}">
                                                <i class="fas fa-cog"></i>Sozlamalar</a>
                                        </li>
                                    </ul>
                                </nav>
                            </aside>
                            <!-- END MENU SIDEBAR-->

                        </div>
                        <div class="col-xl-9">
                            <!-- PAGE CONTENT-->
                            <div class="page-content">
                               
                                <div class="row">
                                    <div class="col-md-12">
                    <section>
                        <div class="container-fluid">
                        <div class="content-wrapper">
                                <div class="col-lg-6">
                            <div class="card">
                                    <div class="card-header">
                                        <strong>Guruh</strong> Sozlamalari
                                    </div>
                                    <div class="card-body card-block">
                                        <form action="/edit-group/{{id}}" method="post">
                                            <div class="form-group">
                                                <label for="groupName" class=" form-control-label">Guruh Nomi</label>
                                                <input type="text" id="groupName" name="groupName" value="{{group.groupName}}" class="form-control" disabled>    
                                            </div>
                                            <div class="form-group">
                                                <label for="groupName" class=" form-control-label">Fan</label>
                                                <input type="text" id="groupName" name="groupName" value="{{group.subject}}" class="form-control" disabled>    
                                            </div>

                                            <label for="level" class=" form-control-label">Daraja</label>
                                            <select name="newLevel" id="newLevel" class="form-control">
                                                <option value="Beginner">Beginner</option>
                                                <option value="Elementry">Elementry</option>
                                                <option value="Pre-Intermediate">Pre-Intermediate</option>
                                                <option value="Intermediate">Intermediate</option>
                                                <option value="Pre-IELTS">Pre-IELTS</option>
                                                <option value="IELTS">IELTS</option>
                                                <option value="Multi Level">Multi Level</option>
                                                <option value="Почемучка">Почемучка</option>
                                                <option value="Началка 1-4 Класс">Началка 1-4 Класс</option>
                                            </select>
                                         <br>
                                            <label for="lessonTime" class=" form-control-label">Dars Vaqti</label>
                                            <select name="newLessonTime" id="newLessonTime" class="form-control">
                                                <option value="8:00-10:00">8:00-10:00</option>
                                                <option value="9:00-11:00">9:00-11:00</option>
                                                <option value="10:00-12:00">10:00-12:00</option>
                                                <option value="12:00-14:00">12:00-14:00</option>
                                                <option value="13:00-15:00">13:00-15:00</option>
                                                <option value="15:00-17:00">15:00-17:00</option>
                                                <option value="14:00-16:00">14:00-16:00</option>
                                                <option value="17:00-19:00">17:00-19:00</option>
                                                <option value="16:00-18:00">16:00-18:00</option>
                                            </select>
                                         <br>
                                              <label for="lessonDay" class=" form-control-label">Dars Kunlari</label>
                                            <select name="newLessonDay" id="lessonDay" class="form-control">
                                                <option value="Har Kuni">Har Kuni (Dushanba-Juma)</option>
                                                <option value="Juft Kunlari">Juft Kunlari</option>
                                                <option value="Toq Kunlari">Toq Kunlari</option>
                                            </select>
                                         <br>
                                         <button type="submit" class="btn btn-primary btn-sm">
                                            <i class="fa fa-plus"></i> Saqlash
                                        </button>
                                        </form> 
                                        <br>
                                        <div class="form-group">
                                                <label for="deleteGroup" class=" form-control-label">Guruhni O'chirish!</label>
                                        <form action="/delete-group/{{id}}">
                                        <button type="submit" class="btn btn-danger btn-sm">
                                            <i class="fa fa-trash"></i> O'chirish
                                        </button>
                                        </form>       
                                            </div>
                                        
                                    </div>

                                </div>
                                
                        </div>
                            </div>
                            </div>
                    </section>
                                </div>
                                </div>
                            
                                <div class="row">
                                <div class="col-md-12">
                                    <div class="copyright text-center py-3" style="background-color: #f8f9fa;">
                                 <p><b>StephenSchool Learning Center.</b> 
                    <b style="text-decoration: underline;">v1.1.3</b></p>
                                   </div>
                                </div>
                                </div>
                            </div>
                            <!-- END PAGE CONTENT-->
                        </div>
                    </div>
                </div>
            </section>
        </div>
        <!-- END PAGE CONTENT  -->

    </div>

    <!-- Jquery JS-->
    <script src="/jquery-3.2.1.min.js"></script>
    <!-- Bootstrap JS-->
    <script src="/bootstrap-4.1/popper.min.js"></script>
    <script src="/bootstrap-4.1/bootstrap.min.js"></script>
    <!-- Vendor JS       -->
    <script src="/slick/slick.min.js">
    </script>
    <script src="/wow/wow.min.js"></script>
    <script src="/animsition/animsition.min.js"></script>
    <script src="/bootstrap-progressbar/bootstrap-progressbar.min.js">
    </script>
    <script src="/counter-up/jquery.waypoints.min.js"></script>
    <script src="/counter-up/jquery.counterup.min.js">
    </script>
    <script src="/circle-progress/circle-progress.min.js"></script>
    <script src="/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="/chartjs/Chart.bundle.min.js"></script>
    <script src="/select2/select2.min.js">
    </script>

    <!-- Main JS-->
    <script src="/js/main.js"></script>

</body>
