<body class="animsition">
    <div class="page-wrapper">
        <!-- HEADER MOBILE-->
        <header class="header-mobile d-block d-lg-none">
            <div class="header-mobile__bar">
                <div class="container-fluid">
                    <div class="header-mobile-inner">
                        <a  href="index.html">
                            <h3>StephenSchool</h3>
                        </a>
                        <button class="hamburger hamburger--slider" type="button">
                            <span class="hamburger-box">
                                <span class="hamburger-inner"></span>
                            </span>
                        </button>
                    </div>
                </div>
            </div>
           <nav class="navbar-mobile">
                <div class="container-fluid">
                    <ul class="navbar-mobile__list list-unstyled">
                        <li>
                            <a href="/admin-dashboard/{{id}}"><i class="fas fa-tachometer-alt"></i>Asosiy Panel</a>
                        </li>
                        <li>
                            <a href="/add-student"><i class="fa fa-graduation-cap"></i>Student qo'shish</a>
                        </li>
                        <li>
                            <a href="/add-teacher"><i class="fa fa-user"></i>O'qituvchi qo'shish</a>
                        </li>
                        <li>
                            <a href="/courses"><i class="fa fa-bookmark"></i>Kurslar</a>
                        </li>
                    </ul>
                </div>
            </nav>
        </header>
        <!-- END HEADER MOBILE-->

        <!-- MENU SIDEBAR-->
        <aside class="menu-sidebar d-none d-lg-block">
            <div class="logo">
                
                   <h3>StephenSchool</h3>
                
            </div>
            <div class="menu-sidebar__content js-scrollbar1">
                <nav class="navbar-sidebar">
                    <ul class="list-unstyled navbar__list">
                        <li class="active has-sub">
                            <a href="/admin"><i class="fas fa-tachometer-alt"></i>Asosiy Panel</a>
                        </li>
                        <li>
                            <a href="/add-student"><i class="fa fa-graduation-cap"></i>Student qo'shish</a>
                        </li>
                        <li>
                            <a href="/add-teacher"><i class="fa fa-user"></i>O'qituvchi qo'shish</a>
                        </li>
                        <li>
                            <a href="/courses"><i class="fa fa-bookmark"></i>Kurslar</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>
        <!-- END MENU SIDEBAR-->

        <!-- PAGE CONTAINER-->
        <div class="page-container">
            <!-- HEADER DESKTOP-->
            <header class="header-desktop">
                <div class="section__content section__content--p30">
                    <div class="container-fluid">
                        <div class="header-wrap">
                            <div class="header-button">
                                <div class="noti-wrap"></div>
                               <div class="account-wrap">
                                    <div class="account-item clearfix js-item-menu">
                                        <div class="image">
                                            <img src="/images/admin-avatar.png" alt="{{adminInfo.userName}}" />
                                        </div>
                                        <div class="content">
                                            <a class="js-acc-btn" href="#">{{adminInfo.userName}}</a>
                                        </div>
                                        <div class="account-dropdown js-dropdown">
                                            <div class="info clearfix">
                                                <div class="image">
                                                    <a href="#">
                                                        <img src="/images/admin-avatar.png" alt="Admin Avatar" />
                                                    </a>
                                                </div>
                                                <div class="content">
                                                    <h5 class="name">
                                                        <a href="#">{{adminInfo.userName}}</a>
                                                    </h5>
                                                    <span class="email">{{adminInfo.phoneNumber}}</span>
                                                </div>
                                            </div>
                                            <div class="account-dropdown__body">
                                                <div class="account-dropdown__item">
                                                    <a href="/admin-profile/{{id}}">
                                                        <i class="zmdi zmdi-account"></i>Profil</a>
                                                </div>
                                                <div class="account-dropdown__item">
                                                    <a href="/admin-settings/{{id}}">
                                                        <i class="zmdi zmdi-settings"></i>Sozlamalar</a>
                                                </div>
                                            </div>
                                            <div class="account-dropdown__footer">
                                                <a href="/logout">
                                                    <i class="zmdi zmdi-power"></i>Chiqish</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </header>
            <!-- HEADER DESKTOP-->

            <!-- MAIN CONTENT-->
            <div class="main-content">
                <div class="section__content section__content--p30">
                    <div class="container-fluid">
                        <div class="content-wrapper">
                        <div class="col-lg-6">
                            <div class="card">
                                    <div class="card-header">
                                        <strong>Yangi</strong> Kurs
                                    </div>
                                    <div class="card-body card-block">
                                        <form action="/new-course" method="post">
                                           <label for="sub" class=" form-control-label">Fanni Tanlang:</label>
                                            <select name="subject" id="subject" class="form-control">
                                                <option value="Ingliz Tili">Ingliz Tili</option>
                                                <option value="Rus Tili">Rus Tili</option>
                                            </select>
                                            <br>
                                            <label for="level" class=" form-control-label">Daraja</label>
                                            <select name="level" id="level" class="form-control">
                                                <option value="Beginner">Beginner</option>
                                                <option value="Elementry">Elementry</option>
                                                <option value="Pre-Intermediate">Pre-Intermediate</option>
                                                <option value="Intermediate">Intermediate</option>
                                                <option value="Pre-IELTS">Pre-IELTS</option>
                                                <option value="IELTS">IELTS</option>
                                                <option value="Multi Level">Multi Level</option>
                                                <option value="Почемучка">Почемучка</option>
                                                <option value="Началка 1-4 Класс">Началка 1-4 Класс</option>
                                            </select>
                                         <br>
                                            <label for="lessonTime" class=" form-control-label">Dars Vaqti</label>
                                            <select name="lessonTime" id="lessonTime" class="form-control">
                                                <option value="8:00-10:00">8:00-10:00</option>
                                                <option value="9:00-11:00">9:00-11:00</option>
                                                <option value="10:00-12:00">10:00-12:00</option>
                                                <option value="12:00-14:00">12:00-14:00</option>
                                                <option value="13:00-15:00">13:00-15:00</option>
                                                <option value="15:00-17:00">15:00-17:00</option>
                                                <option value="14:00-16:00">14:00-16:00</option>
                                                <option value="17:00-19:00">17:00-19:00</option>
                                                <option value="16:00-18:00">16:00-18:00</option>
                                            </select>
                                            <br>
                                            <label for="lessonDay" class=" form-control-label">Dars Kunlari</label>
                                            <select name="lessonDay" id="lessonTime" class="form-control">
                                                <option value="Har Kuni">Har Kuni</option>
                                                <option value="Juft Kunlari">Juft Kunlari</option>
                                                <option value="Toq Kunlari">Toq Kunlari</option>
                                            </select>
                                            <br>
                                             <div class="form-group">
                                                <label for="teacherName" class=" form-control-label">Kurs O'qituvchisi</label>
                                                <input type="text" id="teacherName" name="teacherName" class="form-control">    
                                            </div>
                                            
                                             <div class="form-group">
                                                <label for="coursePrice" class=" form-control-label">Kurs Narxi</label>
                                                <input type="text" id="coursePrice" name="coursePrice" class="form-control" placeholder="Misol: 550,000">    
                                            </div>

                                            <div class="col col-md-6">
                                         <br>
                                         <button type="submit" class="btn btn-primary btn-sm">
                                            <i class="fa fa-plus"></i> Tasdiqlash
                                        </button>
                                        </form>
                                    </div>
                                   
                                </div>
                        </div>
                         
                        <div class="row">
                            <div class="col-md-12">
                                <div class="copyright">
                                    <p><b>StephenSchool</b> Learning Center. Developed by: <a style="color: black;" href="https://t.me/offcodev"><b>offcodev</b></a>.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    </div>
                </div>
            </div>
            <!-- END MAIN CONTENT-->
            <!-- END PAGE CONTAINER-->
        </div>

    </div>

    <!-- Jquery JS-->
    <script src="/jquery-3.2.1.min.js"></script>
    <!-- Bootstrap JS-->
    <script src="/bootstrap-4.1/popper.min.js"></script>
    <script src="/bootstrap-4.1/bootstrap.min.js"></script>
    <!-- Vendor JS       -->
    <script src="/slick/slick.min.js">
    </script>
    <script src="/wow/wow.min.js"></script>
    <script src="/animsition/animsition.min.js"></script>
    <script src="/bootstrap-progressbar/bootstrap-progressbar.min.js">
    </script>
    <script src="/counter-up/jquery.waypoints.min.js"></script>
    <script src="/counter-up/jquery.counterup.min.js">
    </script>
    <script src="/circle-progress/circle-progress.min.js"></script>
    <script src="/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="/chartjs/Chart.bundle.min.js"></script>
    <script src="/select2/select2.min.js">
    </script>

    <!-- Main JS-->
    <script src="js/main.js"></script>

</body>