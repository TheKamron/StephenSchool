<head>

  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <meta name="google-site-verification" content="3eBvyzBYJbrGVRsz_SsNeXzCASH7VllFPgrsWTkoVzY" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@100;200;300;400;500;600;700;800;900&display=swap"
    rel="stylesheet">
  <link rel="shortcut icon" type="image/x-icon" href="/images/logo.jpg">
  <link rel="manifest" href="/site.webmanifest">
  <link rel="apple-touch-icon" sizes="180x180" href="/logo/icon_180x180.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/logo/icon_32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/logo/icon_16x16.png">
  <title>StephenSchool - Step To The Greatness!</title>

  <!-- Bootstrap core CSS -->
  <link href="/bootstrap/css/bootstrap.min.css" rel="stylesheet">


  <!-- Additional CSS Files -->
  <link rel="stylesheet" href="/css/fontawesome.css">
  <link rel="stylesheet" href="/css/stephen.css">
  <link rel="stylesheet" href="/css/owl.css">
  <link rel="stylesheet" href="/css/animate.css">
  <link rel="stylesheet" href="https://unpkg.com/swiper@7/swiper-bundle.min.css" />
</head>

<body>
  <!-- ***** Header Area Start ***** -->
  <header class="header-area header-sticky">
    <div class="container">
      <div class="row">
        <div class="col-12">
          <nav class="main-nav">
            <!-- ***** Logo Start ***** -->
            <a href="/" class="logo">
              <h1>Stephenschool</h1>
            </a>
            <!-- ***** Logo End ***** -->
            <!-- ***** Menu Start ***** -->
            <ul class="nav">
              <li class="scroll-to-section"><a href="#top" class="active">Asosiy</a></li>
              <li class="scroll-to-section"><a href="#courses">Kurslar</a></li>
              <li class="scroll-to-section"><a href="#contact">Kursga Yozilish</a></li>
              <li class="scroll-to-section"><a href="/login">Kirish <i class="fas fa-sign-in"></i></a></li>
            </ul>
            <a class='menu-trigger'>
              <span>Menu</span>
            </a>
            <!-- ***** Menu End ***** -->
          </nav>
        </div>
      </div>
    </div>
  </header>
  <!-- ***** Header Area End ***** -->

  <div class="main-banner" id="top">
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <div class="owl-carousel owl-banner">
            <div class="item item-2">
              <div class="header-text">
                <span class="category">Maqsad</span>
                <h2>A'lo Natijaga Faqatgina Biz Bilan Erishing!</h2>
                <p></p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {{#if contactSuccess}}
  <div class="success">
    <svg class="success__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
      <path d="M10 15.172l-3.95-3.95-1.414 1.414L10 18l9-9-1.414-1.414z"></path>
    </svg>
    <span class="success__title">{{contactSuccess}}</span>
    <svg class="success__close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
      <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z">
      </path>
    </svg>
  </div>
  <script>
    const successElement = document.querySelector('.success');
    document.querySelector('.success__close').addEventListener('click', function () {
      const successElement = document.querySelector('.success');
      successElement.style.display = 'none';
    });
    if (successElement) {
      // 5 soniyadan keyin elementni yashiramiz
      setTimeout(() => {
        successElement.style.display = 'none';
      }, 10000); // 5000ms = 5 sekund
    }
  </script>
  {{/if}}

  <div class="services section" id="services">
    <div class="container">
      <div class="row">
        <div class="col-lg-4 col-md-6">
          <div class="service-item">
            <div class="icon">
              <img src="/images/service-01.png" alt="online degrees">
            </div>
            <div class="main-content">
              <h4>Qulay Ta'lim</h4>
              <p> Biz o‘quvchilarga haftaning 5 kuni davomida to‘liq dars mashg‘ulotlari va dam olish kunlari
                bilimlarini mustahkamlash uchun Mock Exam taklif qilamiz.</p>
              <div class="main-button"></div>
            </div>
          </div>
        </div>
        <div class="col-lg-4 col-md-6">
          <div class="service-item">
            <div class="icon">
              <img src="/images/service-02.png" alt="short courses">
            </div>
            <div class="main-content">
              <h4>Yaxshi Sharoitlar</h4>
              <p>O'quv Markazimiz yorqin, qulay va barcha kerakli jihozlar bilan ta’minlangan o‘quv xonalariga ega va
                biz ta’limni nafaqat samarali, balki qulay qilishga ham intilamiz!</p>
              <div class="main-button"></div>
            </div>
          </div>
        </div>
        <div class="col-lg-4 col-md-6">
          <div class="service-item">
            <div class="icon">
              <img src="/images/service-03.png" alt="web experts">
            </div>
            <div class="main-content">
              <h4>Malakali O'qituvchilar</h4>
              <p>Bizning o‘qituvchilarimiz xorijiy tillarni o‘rgatishda ko‘p yillik tajribaga ega bo‘lib, til
                o‘rganishni qulay va samarali qiladi.</p>
              <div class="main-button"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <section class="section courses" id="courses">
    <div class="container">
      <div class="row">
        <div class="col-lg-12 text-center">
          <div class="section-heading">
            <h6>Bizning Kurslar</h6>
            <h2>Mavjud Kurslar</h2>
          </div>
        </div>
      </div>
      <ul class="event_filter">
        <li>
          <a class="is_active" href="#!" data-filter="*">Barchasi</a>
        </li>
        <li>
          <a href="#!" data-filter=".Beginner, .Elementry">Beginner, Elementry</a>
        </li>
        <li>
          <a href="#!" data-filter=".Pre-Intermediate, .Intermediate">Pre-Intermediate, Intermediate</a>
        </li>
        <li>
          <a href="#!" data-filter=".Pre-IELTS, .IELTS">Pre-IELTS, IELTS</a>
        </li>
      </ul>
      <div class="row event_box">
        {{#if courses.length}}
        {{#each courses}}
        <div class="col-lg-4 col-md-6 align-self-center mb-30 event_outer col-md-6 {{level}}">
          <div class="events_item">
            <div class="thumb">
              <a href="#contact"><img src="/images/{{level}}.jpeg" alt="Course Image"></a>
              {{!-- <span class="price">
                <h6><em></em>{{coursePrice}}</h6>
              </span> --}}
            </div>
            <div class="down-content">
              <span class="author">{{teacherName}}</span>
              <h4>{{subject}} Kursi</h4>
              {{!-- <h4>Dars Vaqti: {{level}}</h4> --}}
            </div>
          </div>
        </div>
        {{/each}}
        {{else}}

        {{/if}}
      </div>
    </div>
  </section>

  <div class="section fun-facts">
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <div class="wrapper">
            <div class="row">
              <div class="col-lg-3 col-md-6">
                <div class="counter">
                  <h2 class="timer count-title count-number" data-to="500" data-speed="1000"></h2>
                  <p class="count-text ">Barcha Studentlar</p>
                </div>
              </div>
              <div class="col-lg-3 col-md-6">
                <div class="counter">
                  <h2 class="timer count-title count-number" data-to="6" data-speed="1000"></h2>
                  <p class="count-text ">O'qituvchilar Soni</p>
                </div>
              </div>
              <div class="col-lg-3 col-md-6">
                <div class="counter">
                  <h2 class="timer count-title count-number" data-to="10" data-speed="1000"></h2>
                  <p class="count-text ">IELTS 7+ Olganlar</p>
                </div>
              </div>
              <div class="col-lg-3 col-md-6">
                <div class="counter end">
                  <h2 class="timer count-title count-number" data-to="10" data-speed="1000"></h2>
                  <p class="count-text ">Tajriba</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>


  <div class="contact-us section" id="contact">
    <div class="container">
      <div class="row">
        <div class="col-lg-6  align-self-center">
          <div class="section-heading">
            <h6>Aloqa</h6>
            <h2>Hoziroq Kursga Yoziling!</h2>
            <p>Agar sizga sifatli ta'lim va a'lo natija kerak bo'lsa bizga qo'shilishingiz mumkin. Buning uchun
              quyidagilarni
              to'ldiring va biz siz bilan tez orada bog'lanamiz!
            </p>
            <div class="special-offer">
              <span class="offer"></span>
              <h6>Manzil: <em>Qarshi Shahar</em></h6>
              <h4>Paxtazor Mikrorayon <em>7/112</em></h4>
              {{!-- <a href="#"><i class="fa fa-angle-right"></i></a> --}}
            </div>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="contact-us-content">
            <form id="contact-form" action="/contact" method="post">
              <div class="row">
                <div class="col-lg-12">
                  <fieldset>
                    <input type="name" name="name" id="name" placeholder="Ism" autocomplete="on" required>
                  </fieldset>
                </div>
                <div class="col-lg-12">
                  <fieldset>
                    <input type="surName" name="surName" id="surName" placeholder="Familya" autocomplete="on" required>
                  </fieldset>
                </div>
                <div class="col-lg-12">
                  <fieldset>
                    <input type="text" name="phoneNumber" id="phoneNumber" placeholder="Telefon Raqamingiz"
                      autocomplete="on" required>
                  </fieldset>
                </div>
                <div class="col-lg-12">
                  <fieldset>
                    <button type="submit" id="form-submit" class="orange-button">Yuborish</button>
                  </fieldset>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>


  <div class="redes">
    <a class="instagram" href="https://instagram.com/stephenschooluz">
      <svg xmlns="http://www.w3.org/2000/svg" fill="#ffffff" viewBox="0,0,550,550" width="25px" height="25px"
        fill-rule="nonzero">
        <path
          d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z">
        </path>
      </svg>
    </a>

    <a class="youtube" href="https://www.youtube.com/@stephenschooluz">
      <svg xmlns="http://www.w3.org/2000/svg" width="25px" height="25px" viewBox="0 0 576 512" fill="white">
        <path
          d="M549.655 124.083c-6.281-23.65-24.787-42.276-48.284-48.583C458.799 64 288 64 288 64s-170.799 0-213.371 11.5c-23.497 6.307-42.003 24.933-48.284 48.583C16 166.824 16 256 16 256s0 89.176 10.345 131.917c6.281 23.65 24.787 42.276 48.284 48.583C117.201 448 288 448 288 448s170.799 0 213.371-11.5c23.497-6.307 42.003-24.933 48.284-48.583C560 345.176 560 256 560 256s0-89.176-10.345-131.917zM232 334.058V177.942L368 256l-136 78.058z" />
