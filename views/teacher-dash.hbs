                        </div>
                    {{!-- Profile --}}
                    </div>
                </div>
            </div>
        </header>
        <!-- END HEADER DESKTOP -->

        <!-- PAGE CONTENT-->
        <div class="page-container3">
            <section class="alert-wrap p-t-30 p-b-30">
                <div class="container">
                </div>
            </section>
            <section>
                <div class="container">
                    <div class="row">
                        {{!-- <div class="col-xl-3"> --}}

                            <!-- MENU SIDEBAR-->
                            <aside class="menu-sidebar3 js-spe-sidebar">
                                <nav class="navbar-sidebar2 navbar-sidebar3">
                                    <ul class="list-unstyled navbar__list">
                                        <li class="active has-sub">
                                <a href="/teacher-dashboard/{{id}}"><i class="fas fa-house"></i>Bosh Sahifa</a>                        
                                        </li>
                                        <li>
                                            <a href="/teacher-profile/{{id}}">
                                                <i class="fas fa-user"></i>Profil</a>
                                        </li>
                                        <li>
                                            <a href="/teacher-settings/{{id}}">
                                                <i class="fas fa-cog"></i>Sozlamalar</a>
                                        </li>
                                    </ul>
                                </nav>
                            </aside>
                            <!-- END MENU SIDEBAR-->

                        {{!-- </div> --}}
                        <div class="col-xl-9">
                            <!-- PAGE CONTENT-->
                            <div class="page-content">
                               <div class="row">
                            <div class="col-md-12">
                                <div class="overview-wrap">
                                    <h2 class="title-1"></h2>
                                    <button class="au-btn au-btn-icon au-btn--blue">
                                       <a style="color: white;" href="/create-group"><i class="zmdi zmdi-plus"></i>Guruh Ochish</a>
                                       </button>
                                </div>
                            </div>
                        </div>
                        <br>

        {{#if myGroup.length}}
        <div class="row">
                                    <div class="col-md-12">
                                        <!-- DATA TABLE-->
                                        <div class="table-responsive m-b-40">
                                            <table class="table table-borderless table-data3">
                                                <thead>
                                                    <tr>
                                                        <th>guruh nomi</th>
                                                        <th>fan</th>
                                                        <th>daraja</th>
                                                        <th>dars vaqti</th>
                                                        <th>dars kuni</th>
                                                        <th>status</th>
                                                        <th>studentlar soni</th>
                                                        <th></th>
                                                    </tr>
                                                </thead>
                                        {{#if myGroup.length}}
                                        {{#each myGroup}}
                                                <tbody>
                                                    <tr>
                                                        <td> <a href="/my-group/{{id}}">{{groupName}}</a></td>
                                                        <td>{{subject}}</td>
                                                        <td>{{level}}</td>
                                                        <td>{{lessonTime}}</td>
                                                        <td>{{lessonDay}}</td>
                                                        <td class="process">{{status}}</td>
                                                        <td>{{students.length}}</td>
                                                        <td>
                                                        <a style="color: black;" href="/edit-group/{{id}}"><i class="fa fa-pen"></i></a>
                                                        </td>
                                                    </tr>
                                                </tbody>                                     
                                        {{/each}} 
                                                {{else}}
                                                    <th>Sizda hech qanday guruhlar yo'q.</th>
                                                {{/if}}
                                            </table>
                                        </div>
                                        <!-- END DATA TABLE -->
                                    </div>
        </div>
        {{else}}
        <div class="notifications-container">
        <div class="error-alert">
         <div class="flex">
            <div class="flex-shrink-0">
        
        <svg aria-hidden="true" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" class="error-svg">
          <path clip-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" fill-rule="evenodd"></path>
        </svg>
      </div>
      <div class="error-prompt-container">
        <p class="error-prompt-heading">Sizning hech qanday Guruhingiz yo'q!
        </p><div class="error-prompt-wrap">
      </div>
      </div>
    </div>
  </div>
        </div>
        {{/if}}

    {{#if loginSuccess}}
    <div class="success">
    <svg class="success__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
        <path d="M10 15.172l-3.95-3.95-1.414 1.414L10 18l9-9-1.414-1.414z"></path>
    </svg>
    <span class="success__title">{{loginSuccess}}</span>
    <svg class="success__close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
        <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"></path>
    </svg>
    </div>
    <script>
     const successElement = document.querySelector('.success');   
    document.querySelector('.success__close').addEventListener('click', function () {
    const successElement = document.querySelector('.success');
    successElement.style.display = 'none';});
    if (successElement) {
            // 5 soniyadan keyin elementni yashiramiz
            setTimeout(() => {
                successElement.style.display = 'none';
            }, 10000); // 5000ms = 5 sekund
        }
    </script>
    {{else}}
