<head>
    <!-- Required meta tags-->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="stephen lc dashboard">
    <meta name="author" content="OFFCODEV">
    <meta name="keywords" content="stephen lc dashboard">
    <link rel="shortcut icon" type="image/x-icon" href="/images/logo.jpg">
    <!-- Title Page-->
    <title>{{title}}</title>

    <!-- Fontfaces CSS-->
    <link href="/css/font-face.css" rel="stylesheet" media="all">
    <link href="/font-awesome-4.7/css/font-awesome.min.css" rel="stylesheet" media="all">
    <link href="/font-awesome-5/css/fontawesome-all.min.css" rel="stylesheet" media="all">
    <link href="/mdi-font/css/material-design-iconic-font.min.css" rel="stylesheet" media="all">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">


    <!-- Bootstrap CSS-->
    <link href="/bootstrap-4.1/bootstrap.min.css" rel="stylesheet" media="all">

    <!-- Vendor CSS-->
    <link href="/animsition/animsition.min.css" rel="stylesheet" media="all">
    <link href="/bootstrap-progressbar/bootstrap-progressbar-3.3.4.min.css" rel="stylesheet" media="all">
    <link href="/wow/animate.css" rel="stylesheet" media="all">
    <link href="/css-hamburgers/hamburgers.min.css" rel="stylesheet" media="all">
    <link href="/slick/slick.css" rel="stylesheet" media="all">
    <link href="/select2/select2.min.css" rel="stylesheet" media="all">
    <link href="/perfect-scrollbar/perfect-scrollbar.css" rel="stylesheet" media="all">

    <!-- Main CSS-->
    <link href="/css/theme.css" rel="stylesheet" media="all">

</head>

<body class="animsition">
    <div class="page-wrapper">
        <!-- HEADER MOBILE-->
        <header class="header-mobile d-block d-lg-none">
            <div class="header-mobile__bar">
                <div class="container-fluid">
                    <div class="header-mobile-inner">
                        <h3>StephenSchool</h3>
                        <button class="hamburger hamburger--slider" type="button">
                            <span class="hamburger-box">
                                <span class="hamburger-inner"></span>
                            </span>
                        </button>
                    </div>
                </div>
            </div>
            <nav class="navbar-mobile">
                <div class="container-fluid">
                    <ul class="navbar-mobile__list list-unstyled">
                        <li class="active">
                            <a href="/admin-dashboard/{{id}}"><i class="fas fa-tachometer-alt"></i>Asosiy Panel</a>
                        </li>
                        <li>
                            <a href="/add-student"><i class="fa fa-graduation-cap"></i>Student qo'shish</a>
                        </li>
                        <li>
                            <a href="/add-teacher"><i class="fa fa-user"></i>O'qituvchi qo'shish</a>
                        </li>
                        <li>
                            <a href="/courses"><i class="fa fa-bookmark"></i>Kurslar</a>
                        </li>
                    </ul>
                </div>
            </nav>
        </header>
        <!-- END HEADER MOBILE-->

        <!-- MENU SIDEBAR-->
        <aside class="menu-sidebar d-none d-lg-block">
            <div class="logo">
                <a href="">
                    <h3>StephenSchool</h3>
                </a>
            </div>
            <div class="menu-sidebar__content js-scrollbar1">
                <nav class="navbar-sidebar">
                    <ul class="list-unstyled navbar__list">
                        <li class="has-sub">
                            <a href="/admin-dashboard/{{id}}"><i class="fas fa-tachometer-alt"></i>Asosiy Panel</a>
                        </li>
                        <li>
                            <a href="/add-student"><i class="fa fa-graduation-cap"></i>Student qo'shish</a>
                        </li>
                        <li>
                            <a href="/add-teacher"><i class="fa fa-user"></i>O'qituvchi qo'shish</a>
                        </li>
                        <li>
                            <a href="/courses"><i class="fa fa-bookmark"></i>Kurslar</a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>
        <!-- END MENU SIDEBAR-->

        <!-- PAGE CONTAINER-->
        <div class="page-container">
            <!-- HEADER DESKTOP-->
            <header class="header-desktop">
                <div class="section__content section__content--p30">
                    <div class="container-fluid">
                        <div class="header-wrap">
                            <div class="header-button">
                                <div class="noti-wrap"></div>
                                <div class="account-wrap">
                                    <div class="account-item clearfix js-item-menu">
                                        <div class="image">
                                            <img src="/images/admin-avatar.png" alt="{{adminInfo.userName}}" />
                                        </div>
                                        <div class="content">
                                            <a class="js-acc-btn" href="#">{{adminInfo.userName}}</a>
                                        </div>
                                        <div class="account-dropdown js-dropdown">
                                            <div class="info clearfix">
                                                <div class="image">
                                                    <a href="#">
                                                        <img src="/images/admin-avatar.png" alt="Admin Avatar" />
                                                    </a>
                                                </div>
                                                <div class="content">
                                                    <h5 class="name">
                                                        <a href="#">{{adminInfo.userName}}</a>
                                                    </h5>
                                                    <span class="email">{{adminInfo.phoneNumber}}</span>
                                                </div>
                                            </div>
                                            <div class="account-dropdown__body">
                                                <div class="account-dropdown__item">
                                                    <a href="/admin-profile/{{id}}">
                                                        <i class="zmdi zmdi-account"></i>Profil</a>
                                                </div>
                                                <div class="account-dropdown__item">
                                                    <a href="/admin-settings/{{id}}">
                                                        <i class="zmdi zmdi-settings"></i>Sozlamalar</a>
                                                </div>
                                            </div>
                                            <div class="account-dropdown__footer">
                                                <a href="/logout">
                                                    <i class="zmdi zmdi-power"></i>Chiqish</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </header>
            <!-- HEADER DESKTOP-->

            <!-- MAIN CONTENT-->
            <div class="main-content">
                <div class="section__content section__content--p30">
                    <div class="container-fluid">

                        <section>
                            <div class="container-fluid">
                                <div class="content-wrapper">
                                    <div class="col-lg-6">
                                        <div class="card">
                                            <div class="card-header">
                                                <strong>Profil</strong> Sozlamalar
                                            </div>
                                            <div class="card-body card-block">
                                                <form action="/admin-update/{{id}}" method="post"
                                                    class="form-horizontal">
                                                    <div class="row form-group">
                                                        <div class="col col-md-3">
                                                            <label for="hf-userName"
                                                                class=" form-control-label">Login</label>
                                                        </div>
                                                        <div class="col-12 col-md-9">
                                                            <input type="text" id="hf-userName" name="hf-userName"
                                                                value="{{adminInfo.userName}}" class="form-control"
                                                                disabled>
                                                        </div>
                                                    </div>

                                                    <div class="row form-group">
                                                        <div class="col col-md-3">
                                                            <label for="hf-phoneNumber"
                                                                class=" form-control-label">Telefon Raqam</label>
                                                        </div>
                                                        <div class="col-12 col-md-9">
                                                            <input type="text" id="phoneNumber" name="phoneNumber"
                                                                value="{{adminInfo.phoneNumber}}" class="form-control"
                                                                disabled>
                                                            {{!-- <span class="help-block">Please enter your
                                                                email</span> --}}
                                                        </div>
                                                    </div>
                                                    <div class="row form-group">
                                                        <div class="col col-md-3">
                                                            <label for="hf-password" class=" form-control-label">Eski
                                                                Parol</label>
                                                        </div>
                                                        <div class="col-12 col-md-9">
                                                            <input type="password" id="hf-password" name="oldPassword"
                                                                class="form-control">
                                                            {{!-- <span class="help-block">Please enter your
                                                                password</span> --}}
                                                        </div>
                                                    </div>
                                                    <div class="row form-group">
                                                        <div class="col col-md-3">
                                                            <label for="hf-password" class=" form-control-label">Yangi
                                                                Parol</label>
                                                        </div>
                                                        <div class="col-12 col-md-9">
                                                            <input type="password" id="hf-password" name="password"
                                                                class="form-control">
                                                            {{!-- <span class="help-block">Please enter your
                                                                password</span> --}}
                                                        </div>
                                                    </div>
                                                    <div class="row form-group">
                                                        <div class="col col-md-3">
                                                            <label for="hf-password" class=" form-control-label">Parolni
                                                                Tasdiqlang</label>
                                                        </div>
                                                        <div class="col-12 col-md-9">
                                                            <input type="password" id="hf-newPassword"
                                                                name="newPassword" class="form-control">
                                                            {{!-- <span class="help-block">Please enter your
                                                                password</span> --}}
                                                        </div>
                                                    </div>
                                                    <div class="card-footer">
                                                        <button type="submit" class="btn btn-primary btn-sm">
                                                            <i class="fa fa-dot-circle-o"></i> Saqlash
                                                        </button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>
                        {{#if settingsError}}
                        <div class="error">
                            <div class="error__icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" viewBox="0 0 24 24" height="24"
                                    fill="none">
                                    <path fill="#393a37"
                                        d="m13 13h-2v-6h2zm0 4h-2v-2h2zm-1-15c-1.3132 0-2.61358.25866-3.82683.7612-1.21326.50255-2.31565 1.23915-3.24424 2.16773-1.87536 1.87537-2.92893 4.41891-2.92893 7.07107 0 2.6522 1.05357 5.1957 2.92893 7.0711.92859.9286 2.03098 1.6651 3.24424 2.1677 1.21325.5025 2.51363.7612 3.82683.7612 2.6522 0 5.1957-1.0536 7.0711-2.9289 1.8753-1.8754 2.9289-4.4189 2.9289-7.0711 0-1.3132-.2587-2.61358-.7612-3.82683-.5026-1.21326-1.2391-2.31565-2.1677-3.24424-.9286-.92858-2.031-1.66518-3.2443-2.16773-1.2132-.50254-2.5136-.7612-3.8268-.7612z">
                                    </path>
                                </svg>
                            </div>
                            <div class="error__title">{{settingsError}}</div>
                            <div class="error__close"><svg xmlns="http://www.w3.org/2000/svg" width="20"
                                    viewBox="0 0 20 20" height="20">
                                    <path fill="#393a37"
                                        d="m15.8333 5.34166-1.175-1.175-4.6583 4.65834-4.65833-4.65834-1.175 1.175 4.65833 4.65834-4.65833 4.6583 1.175 1.175 4.65833-4.6583 4.6583 4.6583 1.175-1.175-4.6583-4.6583z">
                                    </path>
                                </svg></div>
                        </div>
                        <script>
                            document.querySelector('.error__close').addEventListener('click', function () {
                                const errorElement = document.querySelector('.error');
                                errorElement.style.display = 'none';
                            });
                        </script>
                        {{/if}}

                        {{#if settingsSuccess}}
                        <div class="success">
                            <svg class="success__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                <path d="M10 15.172l-3.95-3.95-1.414 1.414L10 18l9-9-1.414-1.414z"></path>
                            </svg>
                            <span class="success__title">{{settingsSuccess}}</span>
                            <svg class="success__close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                <path
                                    d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z">
                                </path>
                            </svg>
                        </div>
                        <script>
                            const successElement = document.querySelector('.success');
                            document.querySelector('.success__close').addEventListener('click', function () {
                                const successElement = document.querySelector('.success');
                                successElement.style.display = 'none';
                            });
                            if (successElement) {
                                // 5 soniyadan keyin elementni yashiramiz
                                setTimeout(() => {
                                    successElement.style.display = 'none';
                                }, 10000); // 5000ms = 5 sekund
                            }
                        </script>
                        {{/if}}
                        <div class="row">
                            <div class="col-md-12">
                                <div class="copyright">
                                    <p><b>StephenSchool</b> Learning Center. Developed by: <a style="color: black;"
                                            href="https://t.me/offcodev"><b>offcodev</b></a>.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- END MAIN CONTENT-->
            <!-- END PAGE CONTAINER-->
        </div>
    </div>

    <!-- Jquery JS-->
    <script src="/jquery-3.2.1.min.js"></script>
    <!-- Bootstrap JS-->
    <script src="/bootstrap-4.1/popper.min.js"></script>
    <script src="/bootstrap-4.1/bootstrap.min.js"></script>
    <!-- Vendor JS       -->
    <script src="/slick/slick.min.js">
    </script>
    <script src="/wow/wow.min.js"></script>
    <script src="/animsition/animsition.min.js"></script>
    <script src="/bootstrap-progressbar/bootstrap-progressbar.min.js">
    </script>
    <script src="/counter-up/jquery.waypoints.min.js"></script>
    <script src="/counter-up/jquery.counterup.min.js">
    </script>
    <script src="/circle-progress/circle-progress.min.js"></script>
    <script src="/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="/chartjs/Chart.bundle.min.js"></script>
    <script src="/select2/select2.min.js">
    </script>

    <!-- Main JS-->
    <script src="/js/main.js"></script>

</body>