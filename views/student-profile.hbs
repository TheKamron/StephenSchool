                                            </div>
                                        </div>

                                        <div class="notifi__footer">
                                            <p style="cursor: default;">All notifications</p>
                                        </div>
                                    </div> --}}
                                </div>
                                 
                                <div class="header-button-item mr-0 js-sidebar-btn">
                                    <i class="zmdi zmdi-menu"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </header>
            
             <aside class="menu-sidebar2 js-right-sidebar d-block d-lg-none">
                <div class="logo">
                    <a href="#"> <h3>StephenSchool</h3> </a>
                </div>
                <div class="menu-sidebar2__content js-scrollbar2">
                    <div class="account2">
                        <div class="image img-cir img-120">
                            <img src="/images/{{avatar}}.png" alt="Avatar" />
                        </div>
                        <h4 class="name">{{firstName}} {{surName}}</h4>
                        <a href="">{{phoneNumber}}</a>
                    </div>
                    <nav class="navbar-sidebar2">
                        <ul class="list-unstyled navbar__list">
                            <li>
                                <a href="/student-dashboard/{{id}}">
                                <i class="fas fa-home"></i>Bosh Sahifa</a>
                            </li>
                            <li  class="active">
                                <a href="/student-profile/{{id}}">
                                    <i class="fas fa-user"></i>Profil</a>
                            </li> 
                            <li>
                            <a href='/exam-results/{{id}}'>
                                <i class="fas fa-trophy"></i>Mock Natijalarim</a>                        
                            </li>
                             <li>
                                <a href="/student-settings/{{id}}">
                                    <i class="fas fa-cog"></i>Sozlamalar</a>
                            </li>  
                        </ul>
                    </nav>
                </div>
            </aside>
            <!-- END HEADER DESKTOP-->
            <section>
                <div class="section__content section__content--p30">
                    <div class="container-fluid">
                        <div class="row">
                            <div class="col-md-12">
                            
                            </div>
                        </div>
                    </div>
                </div>
            </section>      
            <br>
            <br>
            <br>
            <section>
            <div class="section__content section__content--p30 d-flex justify-content-center align-items-center" style="min-height: 100vh;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="profile-card">
                    <!-- Profil Bo'limi -->
                    <div class="card-header text-center">
                        <i class="fa fa-user"></i>
                        <strong class="card-title pl-2">Mening Profilim</strong>
                    </div>
                    <div class="card-body">
                        <div class="mx-auto d-block text-center">
                            <img 
                                class="rounded-circle mx-auto d-block avatar-img img-fluid" 
                                src="/images/{{avatar}}.png" 
                                alt="Profil rasmi"
                                style="width: 100px; height: 100px; object-fit: cover;">
                            <h5 class="mt-2 mb-1">{{firstName}} {{surName}}</h5>
                            <div class="location">
                                <i class="fa fa-phone"></i> {{phoneNumber}}
                            </div>
                            <div class="location">
                                <i class="fa fa-id-card"></i> {{age}} Yosh
                            </div>
                            <div class="location">
                                <i class="fa fa-clock"></i> {{formatDate_2 user.createdAt}} 
                            </div>
                        </div>
                        <hr>
                        <!-- Guruh Bo'limi -->
                        <div class="card-header text-center">
                            <i class="fa fa-info-circle"></i>
                            <strong class="card-title pl-2">Guruh</strong>
                        </div>
                        <br>
                        {{#if group}}
                        <ul class="list-unstyled text-center">
                            <li>Guruh Nomi: <b>{{groupName}}</b></li>
                            <li>Fan: <b>{{groupSubject}}</b></li>
                            <li>Daraja: <b>{{groupLevel}}</b></li>
                        </ul>
                        {{else}}
                        <div class="location">
                                <i class="fa fa-danger"></i>Siz hech qanday guruh tarkibida emassiz!
                            </div>
                        {{/if}}
                        
                        <hr>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

            </section>
                

               
            <section>
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-12"  style="min-height: 100px;">
                            <div class="copyright">
                    <p><b>StephenSchool Learning Center.</b> 
                    <b style="text-decoration: underline;">v1.1.3</b></p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        

    </div>
    <!-- Jquery JS-->
    <script src="/jquery-3.2.1.min.js"></script>
    <!-- Bootstrap JS-->
    <script src="/bootstrap-4.1/popper.min.js"></script>
    <script src="/bootstrap-4.1/bootstrap.min.js"></script>
    <!-- Vendor JS       -->
    <script src="/slick/slick.min.js">
    </script>
    <script src="/wow/wow.min.js"></script>
    <script src="/animsition/animsition.min.js"></script>
    <script src="/bootstrap-progressbar/bootstrap-progressbar.min.js">
    </script>
    <script src="/counter-up/jquery.waypoints.min.js"></script>
    <script src="/counter-up/jquery.counterup.min.js">
    </script>
    <script src="/circle-progress/circle-progress.min.js"></script>
    <script src="/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="/chartjs/Chart.bundle.min.js"></script>
    <script src="/select2/select2.min.js">
    </script>
    <script src="/vector-map/jquery.vmap.js"></script>
    <script src="/vector-map/jquery.vmap.min.js"></script>
    <script src="/vector-map/jquery.vmap.sampledata.js"></script>
    <script src="/vector-map/jquery.vmap.world.js"></script>

    <!-- Main JS-->
    <script src="/js/main.js"></script>

</body>



