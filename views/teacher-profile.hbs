<head>
  <!-- Required meta tags-->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
  <meta name="description" content="stephen lc dashboard" />
  <meta name="author" content="OFFCODEV" />
  <meta name="keywords" content="stephen lc dashboard" />
  <link rel="shortcut icon" type="image/x-icon" href="/images/logo.jpg" />
  <!-- Title Page-->
  <title>{{title}}</title>

  <!-- Fontfaces CSS-->
  <link href="/css/font-face.css" rel="stylesheet" media="all" />
  <link href="/font-awesome-4.7/css/font-awesome.min.css" rel="stylesheet" media="all" />
  <link href="/font-awesome-5/css/fontawesome-all.min.css" rel="stylesheet" media="all" />
  <link href="/mdi-font/css/material-design-iconic-font.min.css" rel="stylesheet" media="all" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

  <!-- Bootstrap CSS-->
  <link href="/bootstrap-4.1/bootstrap.min.css" rel="stylesheet" media="all" />

  <!-- Vendor CSS-->
  <link href="/animsition/animsition.min.css" rel="stylesheet" media="all" />
  <link href="/bootstrap-progressbar/bootstrap-progressbar-3.3.4.min.css" rel="stylesheet" media="all" />
  <link href="/wow/animate.css" rel="stylesheet" media="all" />
  <link href="/css-hamburgers/hamburgers.min.css" rel="stylesheet" media="all" />
  <link href="/slick/slick.css" rel="stylesheet" media="all" />
  <link href="/select2/select2.min.css" rel="stylesheet" media="all" />
  <link href="/perfect-scrollbar/perfect-scrollbar.css" rel="stylesheet" media="all" />

  <!-- Main CSS-->
  <link href="/css/theme.css" rel="stylesheet" media="all" />

</head>

<body class="animsition">
  <div class="page-wrapper">
    <!-- HEADER DESKTOP-->
    <header class="header-desktop4">
      <div class="container">
        <div class="header4-wrap">
          <div class="header__logo">
            <h3><a style="color: #4272d7" href="/">StephenSchool</a></h3>
          </div>
          <div class="header__tool">
            <div class="header-button-item has-noti js-item-menu">
            </div>
            {{! Profile Settings }}
            <div class="account-wrap">
              <div class="account-item account-item--style2 clearfix js-item-menu">
                {{#ifeq avatar "male.jpg" "female.jpg"}}
                <div class="image">
                  <img src="/images/{{avatar}}" alt="Avatar" />
                </div>
                {{else}}
                <div class="image">
                  <img src="{{avatar}}" alt="Avatar" />
                </div>
                {{/ifeq}}
                <div class="content">
                  <a class="js-acc-btn" href="#">{{firstName}} {{surName}}</a>
                </div>
                <div class="account-dropdown js-dropdown">
                  <div class="info clearfix">
                    {{#ifeq avatar "male.jpg" "female.jpg"}}
                    <div class="image">
                      <img src="/images/{{avatar}}" alt="Avatar" />
                    </div>
                    {{else}}
                    <div class="image">
                      <img src="{{avatar}}" alt="Avatar" />
                    </div>
                    {{/ifeq}}
                    <div class="content">
                      <h5 class="name">
                        <a href="#">{{firstName}} {{surName}}</a>
                      </h5>
                      <span class="email">{{phoneNumber}}</span>
                    </div>
                  </div>
                  <div class="account-dropdown__body">
                    <div class="account-dropdown__item">
                      <a href="/teacher-dashboard/{{id}}">
                        <i class="zmdi zmdi-home"></i>Bosh Sahifa</a>
                    </div>
                    <div class="account-dropdown__item">
                      <a href="/teacher-profile/{{id}}">
                        <i class="zmdi zmdi-account"></i>Profil</a>
                    </div>
                    <div class="account-dropdown__item">
                      <a href="/teacher-settings/{{id}}">
                        <i class="zmdi zmdi-settings"></i>Sozlamalar</a>
                    </div>
                  </div>
                  <div class="account-dropdown__footer">
                    <a href="/logout">
                      <i class="zmdi zmdi-power"></i>Chiqish</a>
                  </div>
                </div>
              </div>
            </div>
            {{! Profile Settings }}
          </div>
        </div>
      </div>
    </header>
    <!-- END HEADER DESKTOP -->

    <!-- PAGE CONTENT-->
    <div class="page-container3">
      <section class="alert-wrap p-t-30 p-b-30">
        <div class="container">
        </div>
      </section>
      <section>
        <div class="container">
          <div class="row">
            <div class="col-xl-3">

              <!-- MENU SIDEBAR-->
              <aside class="menu-sidebar3 js-spe-sidebar">
                <nav class="navbar-sidebar2 navbar-sidebar3">
                  <ul class="list-unstyled navbar__list">
                    <li class="has-sub">
                      <a href="/teacher-dashboard/{{id}}"><i class="fas fa-house"></i>Bosh Sahifa</a>
                    </li>
                    <li class="active">
                      <a href="/teacher-profile/{{id}}">
                        <i class="fas fa-user"></i>Profil</a>
                    </li>
                    <li class="has-sub">
                      <a href="/teacher-settings/{{id}}">
                        <i class="fas fa-cog"></i>Sozlamalar</a>
                    </li>
                  </ul>
                </nav>
              </aside>
              <!-- END MENU SIDEBAR-->

            </div>
            <div class="col-xl-9">
              <!-- PAGE CONTENT-->
              <div class="page-content">

                <div class="row">
                  <div class="col-md-12">
                    <section>
                      <div class="container-fluid">
                        <div class="content-wrapper">
                          <div class="col-lg-6">
                            <div class="card">
                              <div class="card-header">
                                <strong>
                                  <i class="fa fa-user"></i>
                                  Mening Profilim</strong>
                              </div>
                              <div class="card-body card-block">
                                <div class="profile-picture-wrapper">
                                  {{#ifeq avatar "male.jpg" "female.jpg"}}
                                  <img src="/images/{{avatar}}" alt="User Profile Picture" class="profile-picture" />
                                  {{else}}
                                  <img src="{{avatar}}" alt="User Profile Picture" class="profile-picture" />
                                  {{/ifeq}}

                                </div>
                                <div class="form-group">
                                  <label for="userName" class="form-control-label">
                                    <i class="fa fa-id-card"></i>
                                    Ism Familya</label>
                                  <input type="text" id="phoneNumber" name="phoneNumber"
                                    placeholder="{{firstName}} {{surName}}" class="form-control" disabled />
                                </div>
                                <div class="form-group">
                                  <label for="phoneNumber" class="form-control-label"><i class="fa fa-phone"></i>
                                    Telefon Raqam</label>
                                  <input type="text" id="phoneNumber" name="phoneNumber" value="{{phoneNumber}}"
                                    class="form-control" disabled />
                                </div>
                                <div class="form-group">
                                  <label for="subject" class="form-control-label"><i class="fa fa-bookmark"></i>
                                    Fan O'qituvchisi</label>
                                  {{#ifequal user.subject "english"}}
                                  <input type="text" id="subject" name="subject" value="Ingliz Tili"
                                    class="form-control" disabled />
                                  {{/ifequal}}
                                  {{#ifequal user.subject "russian"}}
                                  <input type="text" id="subject" name="subject" value="Rus Tili" class="form-control"
                                    disabled />
                                  {{/ifequal}}
                                  {{#ifequal user.subject "korean"}}
                                  <input type="text" id="subject" name="subject" value="Koreys Tili"
                                    class="form-control" disabled />
                                  {{/ifequal}}
                                </div>
                                <div class="form-group">
                                  <label for="registeredAt" class="form-control-label"><i class="fa fa-clock"></i>
                                    Ro'yxatdan O'tilgan Sana</label>
                                  <input type="text" id="registeredAt" name="registeredAt"
                                    value="{{formatDate_2 user.createdAt}}" class="form-control" disabled />
                                </div>

                                <button class="btn btn-warning btn-sm"><a style="color: black;"
                                    href="/teacher-settings/{{id}}"><i class="fa fa-pen"></i>
                                    Sozlamalar</a></button>
                              </div>

                            </div>
                          </div>
                        </div>
                      </div>
                    </section>
                  </div>
                </div>

                <div class="row">
                  <div class="col-md-12">
                    <div class="copyright text-center py-3" style="background-color: #f8f9fa;">
                      <p><b>StephenSchool Learning Center.</b>
                        <b style="text-decoration: underline;">v1.1.5</b>
                      </p>
                    </div>
                  </div>
                </div>
              </div>
              <!-- END PAGE CONTENT-->
            </div>
          </div>
        </div>
      </section>
    </div>
    <!-- END PAGE CONTENT  -->

  </div>

  <!-- Jquery JS-->
  <script src="/jquery-3.2.1.min.js"></script>
  <!-- Bootstrap JS-->
  <script src="/bootstrap-4.1/popper.min.js"></script>
  <script src="/bootstrap-4.1/bootstrap.min.js"></script>
  <!-- Vendor JS       -->
  <script src="/slick/slick.min.js">
  </script>
  <script src="/wow/wow.min.js"></script>
  <script src="/animsition/animsition.min.js"></script>
  <script src="/bootstrap-progressbar/bootstrap-progressbar.min.js">
  </script>
  <script src="/counter-up/jquery.waypoints.min.js"></script>
  <script src="/counter-up/jquery.counterup.min.js">
  </script>
  <script src="/circle-progress/circle-progress.min.js"></script>
  <script src="/perfect-scrollbar/perfect-scrollbar.js"></script>
  <script src="/chartjs/Chart.bundle.min.js"></script>
  <script src="/select2/select2.min.js">
  </script>

  <!-- Main JS-->
  <script src="/js/main.js"></script>

</body>