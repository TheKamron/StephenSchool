                    <div class="col-xl-9">
                        <!-- PAGE CONTENT-->
                        <div class="page-content">
                            <div class="row">
                                <div class="col-md-12">

                                </div>
                            </div>
                            <br>

                            <!-- DATA TABLE -->
                            <div class="row">

                                <div class="col-md-12">
                                    <div class="table-data__tool">
                                        <div class="table-data__tool-left">
                                            <h3 class="title-5 m-b-35">Guruh Ro'yxati</h3>
                                        </div>
                                        <div class="table-data__tool-right">
                                            <button class="au-btn au-btn-icon au-btn--green au-btn--small"
                                                data-toggle="modal" data-target="#smallmodal">
                                                <i class="zmdi zmdi-plus"></i>Student Qo'shish</button>

                                            <button class="au-btn au-btn-icon au-btn--blue au-btn--small"><i
                                                    class="fa fa-star"></i><a href="/my-group/{{id}}/mock"
                                                    style="color: white;">Mock</a></button>

                                            {{!-- <button class="au-btn au-btn-icon au-btn--green au-btn--small"
                                                data-toggle="modal" data-target="#smallmodal">
                                                <i class="zmdi zmdi-table"></i>Baholash</button> --}}
                                        </div>
                                    </div>
                                </div>
                                <div class="table-responsive table-responsive-data2">
                                    <table class="table table-data2">
                                        <thead>
                                            <tr>
                                                <th>Ism, Familya</th>
                                                <th>Telefon Raqam</th>
                                                <th>Tug'ilgan Kuni</th>
                                                <th>status</th>
                                                <th>Jinsi</th>
                                            </tr>
                                        </thead>
                                        <tbody>

                                            {{#each students}}
                                            <tr class="tr-shadow">
                                                <td>{{this.firstName}} {{this.surName}}</td>
                                                <td>
                                                    <span class="block-email">{{this.phoneNumber}}</span>
                                                </td>
                                                <td>{{this.birthDate}}</td>
                                                <td>
                                                    <span class="status--process">Aktiv</span>
                                                </td>
                                                {{#ifequal this.gender "boy"}}
                                                <td>Erkak</td>
                                                {{else}}
                                                <td>Ayol</td>
                                                {{/ifequal}}
                                                <td>
                                                    <div class="table-data-feature">
                                                        <form action="/remove-student/{{this.id}}" method="post">
                                                            <button class="item" data-toggle="tooltip"
                                                                data-placement="top" title="Delete">
                                                                <i class="zmdi zmdi-delete"></i>
                                                            </button>
                                                            <input type="text" name="groupId" id="groupId"
                                                                value="{{this.group}}" hidden>
                                                        </form>

                                                    </div>
                                                </td>
                                            </tr>
                                            {{/each}}
                                            <tr class="spacer"></tr>

                                        </tbody>
                                    </table>
                                </div>

                            </div>

                        </div>
                        <!-- END DATA TABLE -->

                        <!-- data modal -->
                        <div class="modal fade" id="smallmodal" tabindex="-1" role="dialog"
                            aria-labelledby="smallmodalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-sm" role="document">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="smallmodalLabel">Yangi Student</h5>
                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                    </div>
                                    <div class="modal-body">
                                        <p>Guruhingizga qo'shmoqchi bo'lgan Studentning <b>Telefon Raqamini</b>
                                            kiriting.</p>
                                        <div class="modal-body">
                                            <form action="/invite-student/{{id}}" method="post">
                                                <div class="form-group">
                                                    <label for="phoneNumber" class=" form-control-label">Telefon
                                                        Nomer</label>
                                                    <input type="text" id="phoneNumber" name="phoneNumber" value="+998"
                                                        class="form-control">
                                                </div>
                                                <br>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary"
                                                        data-dismiss="modal">Bekor Qilish</button>
                                                    <button type="submit" class="btn btn-primary">Qo'shish</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="modal fade" id="mockModal" tabindex="-1" role="dialog"
                            aria-labelledby="smallmodalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-sm" role="document">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="smallmodalLabel">Mock natijalari</h5>
                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="modal-body">
                                            <form action="" method="post">
                                                <div class="form-group">
                                                    <label for="homeworkLesson"
                                                        class=" form-control-label">Student</label>
                                                    <select name="" id="">
                                                        {{#each students}}
                                                        <option value="">{{firstName}} {{surName}}</option>
                                                        {{/each}}
                                                    </select>
                                                    {{!-- <input type="text" id="homeworkLesson" name="homeworkLesson"
                                                        placeholder="Present Simple.." class="form-control"> --}}
                                                </div>
                                                <div class="form-group">
                                                    <label for="tasks" class=" form-control-label">Vazifalar</label>
                                                    <textarea
                                                        style="border: 3px rgb(192, 191, 191) solid; border-radius: 5px; display: block;"
                                                        name="tasks" id="tasks"></textarea>
                                                </div>
                                                <br>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary"
                                                        data-dismiss="modal">Bekor Qilish</button>
                                                    <button type="submit" class="btn btn-primary">Qo'shish</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="modal fade" id="removeStudentModal" tabindex="-1" role="dialog"
                            aria-labelledby="smallmodalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-sm" role="document">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="smallmodalLabel">Uyga Vazifa</h5>
                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="modal-body">
                                            <form action="/post-homework/{{id}}" method="post">
                                                <div class="form-group">
                                                    <label for="homeworkLesson"
                                                        class=" form-control-label">Mavzu</label>
                                                    <input type="text" id="homeworkLesson" name="homeworkLesson"
                                                        placeholder="Present Simple.." class="form-control">
                                                </div>
                                                <div class="form-group">
                                                    <label for="tasks" class=" form-control-label">Vazifalar</label>
                                                    <textarea
                                                        style="border: 3px rgb(192, 191, 191) solid; border-radius: 5px; display: block;"
                                                        name="tasks" id="tasks"></textarea>
                                                </div>
                                                <br>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary"
                                                        data-dismiss="modal">Bekor Qilish</button>
                                                    <button type="submit" class="btn btn-primary">Qo'shish</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                        <!-- data modal -->
                        {{#if groupError}}
                        <div class="error">
                            <div class="error__icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" viewBox="0 0 24 24" height="24"
                                    fill="none">
                                    <path fill="#393a37"
                                        d="m13 13h-2v-6h2zm0 4h-2v-2h2zm-1-15c-1.3132 0-2.61358.25866-3.82683.7612-1.21326.50255-2.31565 1.23915-3.24424 2.16773-1.87536 1.87537-2.92893 4.41891-2.92893 7.07107 0 2.6522 1.05357 5.1957 2.92893 7.0711.92859.9286 2.03098 1.6651 3.24424 2.1677 1.21325.5025 2.51363.7612 3.82683.7612 2.6522 0 5.1957-1.0536 7.0711-2.9289 1.8753-1.8754 2.9289-4.4189 2.9289-7.0711 0-1.3132-.2587-2.61358-.7612-3.82683-.5026-1.21326-1.2391-2.31565-2.1677-3.24424-.9286-.92858-2.031-1.66518-3.2443-2.16773-1.2132-.50254-2.5136-.7612-3.8268-.7612z">
                                    </path>
                                </svg>
                            </div>
                            <div class="error__title">{{groupError}}</div>
                            <div class="error__close"><svg xmlns="http://www.w3.org/2000/svg" width="20"
                                    viewBox="0 0 20 20" height="20">
                                    <path fill="#393a37"
                                        d="m15.8333 5.34166-1.175-1.175-4.6583 4.65834-4.65833-4.65834-1.175 1.175 4.65833 4.65834-4.65833 4.6583 1.175 1.175 4.65833-4.6583 4.6583 4.6583 1.175-1.175-4.6583-4.6583z">
                                    </path>
                                </svg></div>
                        </div>
                        <script>
                            const errorElement = document.querySelector('.error');
                            document.querySelector('.error__close').addEventListener('click', function () {
                                const errorElement = document.querySelector('.error');
                                errorElement.style.display = 'none';
                            });
                            if (errorElement) {
                                // 5 soniyadan keyin elementni yashiramiz
                                setTimeout(() => {
                                    errorElement.style.display = 'none';
                                }, 9000); // 5000ms = 5 sekund
                            }
                        </script>
                        {{/if}}

                        {{#if inviteSuccess}}
                        <div class="success">
                            <svg class="success__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                <path d="M10 15.172l-3.95-3.95-1.414 1.414L10 18l9-9-1.414-1.414z"></path>
                            </svg>
                            <span class="success__title">{{inviteSuccess}}</span>
                            <svg class="success__close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                <path
                                    d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z">
                                </path>
                            </svg>
                        </div>
                        <script>
                            const successElement = document.querySelector('.success');
                            document.querySelector('.success__close').addEventListener('click', function () {
                                const successElement = document.querySelector('.success');
                                successElement.style.display = 'none';
                            });
                            if (successElement) {
                                // 5 soniyadan keyin elementni yashiramiz
                                setTimeout(() => {
                                    successElement.style.display = 'none';
                                }, 10000); // 5000ms = 5 sekund
                            }
                        </script>
                        {{/if}}

                        <br>
                        <br>
                        {{!-- tasks --}}
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="au-card au-card--no-shadow au-card--no-pad m-b-40">
                                    <div class="au-card-title" style="background-image:url('images/bg-title-02.jpg');">
                                        <div class="bg-overlay bg-overlay--blue"></div>
                                        <h3>
                                            <i class="zmdi zmdi-comment-text"></i>Uyga vazifalar
                                        </h3>
                                        {{!-- <button class="au-btn-plus">
                                            <i class="zmdi zmdi-plus"></i>
                                        </button> --}}
                                    </div>
                                    <div class="au-inbox-wrap ">
                                        <div class="au-message">

                                            <div class="au-task-list">
                                                {{#each tasks}}
                                                <div class="au-message__item unread">
                                                    <div class="au-message__item-inner">
                                                        <div class="au-message__item-text">
                                                            {{#ifequal status "Pending"}}
                                                            {{#ifeq avatar "boy.png" "girl.png"}}
                                                            <div class="avatar-wrap online">
                                                                <div class="avatar">
                                                                    <img src="/images/{{avatar}}" alt="Avatar">
                                                                </div>
                                                            </div>
                                                            {{else}}
                                                            <div class="avatar-wrap online">
                                                                <div class="avatar">
                                                                    <img src="{{avatar}}" alt="Avatar">
                                                                </div>
                                                            </div>
                                                            {{/ifeq}}
                                                            {{else}}
                                                            {{#ifeq avatar "boy.png" "girl.png"}}
                                                            <div class="avatar-wrap">
                                                                <div class="avatar">
                                                                    <img src="/images/{{avatar}}" alt="Avatar">
                                                                </div>
                                                            </div>
                                                            {{else}}
                                                            <div class="avatar-wrap">
                                                                <div class="avatar">
                                                                    <img src="{{avatar}}" alt="Avatar">
                                                                </div>
                                                            </div>
                                                            {{/ifeq}}
                                                            {{/ifequal}}
                                                            <div class="text">
                                                                <h5 class="name">{{firstName}} {{surName}}</h5>
                                                                <form action="/task-checked/{{this.id}}" method="post">
                                                                    <select name="taskStatus" id="taskStatus"
                                                                        class="taskStatus">
                                                                        <option value="{{status}}">{{status}}</option>
                                                                        <option value="Completed">Completed</option>
                                                                        <option value="Not-Completed">Not-Completed
                                                                        </option>
                                                                        <option value="Cheated">Cheated</option>
                                                                        <option value="Failed">Failed</option>
                                                                    </select>

                                                                    {{#ifequal status "Pending"}}
                                                                    <button class="check-task-btn">Tekshirish</button>
                                                                    {{else}}
                                                                    <button class="checked-btn" disabled>Tekshirildi <i
                                                                            class="fas fa-check-circle"></i></button>
                                                                    {{/ifequal}}

                                                                </form>
                                                                <div class="task-images">
                                                                    {{#each image}}
                                                                    <img src="{{this}}" class="task-thumb previewable"
                                                                        alt="task image" data-full="{{this}}">
                                                                    {{/each}}
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="au-message__item-time">
                                                            <span>{{formatDate date}}</span>
                                                        </div>
                                                    </div>
                                                </div>
                                                {{/each}}
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal fade" id="taskModal" tabindex="-1" role="dialog"
                            aria-labelledby="largeModalLabel" aria-hidden="true" style="display: none;">
                            <div class="modal-dialog modal-lg" role="document">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="largeModalLabel">Topshiriqlar:</h5>
                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                            <span aria-hidden="true">×</span>
                                        </button>
                                    </div>
                                    <div class="modal-body">
                                        <img src="{{image}}" alt="">
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary"
                                            data-dismiss="modal">Cancel</button>
                                        <button type="button" class="btn btn-primary">Confirm</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {{!-- tasks --}}
                        <div class="row">
                            <div class="col-md-12">
                                <div class="copyright text-center py-3" style="background-color: #f8f9fa;">
                                    <p><b>StephenSchool Learning Center.</b>
                                        <b style="text-decoration: underline;">v1.1.5</b>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- END PAGE CONTENT-->
                </div>
        </div>
    </div>
    </section>
    </div>
