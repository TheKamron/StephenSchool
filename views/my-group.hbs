    <script>
        document.querySelectorAll('.previewable').forEach(img => {
            img.addEventListener('click', function (e) {
                const fullImg = this.getAttribute('data-full')
                document.getElementById('imgPreview').src = fullImg
                document.getElementById('imgOverlay').classList.add('active')
            })
        })

        function hideOverlay() {
            document.getElementById('imgOverlay').classList.remove('active')
        }
    </script>
</body>